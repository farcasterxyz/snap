{
  "name": "snap",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "@expo/metro-config>postcss": "^8.5.23",
      "@farcaster/snap-hono>satori": "^0.33.5",
      "@shuding/opentype.js>fflate": "0.7.5",
      "satori>fflate": "0.7.5",
      "xcode>uuid": "^11.1.1",
      "glob@13": "^14.0.2",
      "minimatch@9": "^11.0.1",
      "minimatch@10": "^11.0.1",
      "metro@0.83": "0.83.8",
      "metro-babel-transformer@0.83": "0.83.8",
      "metro-cache@0.83": "0.83.8",
      "metro-cache-key@0.83": "0.83.8",
      "metro-config@0.83": "0.83.8",
      "metro-core@0.83": "0.83.8",
      "metro-file-map@0.83": "0.83.8",
      "metro-minify-terser@0.83": "0.83.8",
      "metro-resolver@0.83": "0.83.8",
      "metro-runtime@0.83": "0.83.8",
      "metro-source-map@0.83": "0.83.8",
      "metro-symbolicate@0.83": "0.83.8",
      "metro-transform-plugins@0.83": "0.83.8",
      "metro-transform-worker@0.83": "0.83.8"
    }
  },
  "scripts": {
    "build": "turbo build",
    "changeset:prepublish": "pnpm --filter './pkgs/*' build",
    "changeset:publish": "pnpm changeset:prepublish && changeset publish",
    "changeset:version": "pnpm install --lockfile-only && changeset version && pnpm typecheck",
    "clean": "pnpm run -r --parallel clean",
    "dev": "turbo dev",
    "preinstall": "npx only-allow pnpm",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.8",
    "only-allow": "^1.2.1",
    "turbo": "^2.4.4"
  }
}
